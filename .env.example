# CONTACT_MODE=webhook
# CONTACT_ENDPOINT=https://your-independent-backend.example/api/contact
# CONTACT_API_TOKEN=

# Set your final public URL before the production build.
NEXT_PUBLIC_SITE_URL=https://techgy-link-reimagined.phanikrishna.chatgpt.site
